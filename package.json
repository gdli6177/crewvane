{
  "name": "crewvane",
  "version": "0.7.0",
  "description": "Crewvane｜协航 — 一位管家，整理所有事。",
  "license": "MIT",
  "type": "module",
  "bin": {
    "crewvane": "./cli/bin/crewvane.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gdli6177/crewvane.git"
  },
  "scripts": {
    "test": "pnpm --dir cli test && pnpm --filter @crewvane/core test && pnpm --filter @crewvane/desktop test",
    "typecheck": "pnpm -r typecheck",
    "desktop:dev": "pnpm --dir apps/desktop dev",
    "desktop:build": "pnpm --dir apps/desktop build",
    "desktop:package": "pnpm --dir apps/desktop package",
    "desktop:dist": "pnpm --dir apps/desktop dist",
    "test:installers": "node scripts/installer-smoke.mjs",
    "test:desktop": "tsx scripts/desktop-smoke.mjs",
    "test:terminal": "node scripts/herdr-terminal-smoke.mjs",
    "test:onboarding": "tsx scripts/onboarding-smoke.mjs",
    "test:delegation": "tsx scripts/delegation-smoke.mjs",
    "test:scene-sync": "tsx scripts/scene-attention-smoke.mjs",
    "test:settled-watchdog": "tsx scripts/settled-watchdog-smoke.mjs",
    "test:task-pool": "tsx scripts/task-pool-smoke.mjs",
    "test:external-wait": "tsx scripts/external-wait-smoke.mjs",
    "test:agent-hooks": "tsx scripts/agent-hooks-smoke.mjs",
    "desktop": "pnpm --dir apps/desktop dev",
    "build": "pnpm --dir apps/desktop build",
    "package:mac": "pnpm --dir apps/desktop package"
  },
  "packageManager": "pnpm@10.4.1",
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.20.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
