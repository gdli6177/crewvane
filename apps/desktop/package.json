{
  "name": "@crewvane/desktop",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "pnpm package && ./release/Crewvane-darwin-arm64/Crewvane.app/Contents/MacOS/Crewvane",
    "build": "electron-rebuild -w node-pty && node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "package": "pnpm build && node package.mjs",
    "package:mac": "pnpm package",
    "dist": "pnpm package && node distribute.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@electron/rebuild": "^4.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.2.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "string-argv": "^0.3.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  }
}
